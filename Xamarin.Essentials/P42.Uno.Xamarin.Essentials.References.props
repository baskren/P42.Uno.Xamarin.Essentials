<Project ToolsVersion="15.0">


  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally> 
  </PropertyGroup>

  <!-- SHARED REFERENCES -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <!-- PLATFORM SPECIFIC REFERENCES -->
  <ItemGroup Condition=" $(TargetFramework.Contains('windows')) ">
    <PackageReference Include="PInvoke.User32" Version="0.7.124"/>
  </ItemGroup>
  <ItemGroup Condition=" !$(TargetFramework.Contains('windows')) ">
  </ItemGroup>
  
  <Choose>
    <When Condition="  $(TargetFramework.ToLower().Contains('android'))  ">
      <ItemGroup>
        <AndroidResource Include="Resources\xml\*.xml" />
        <!-- Uno.Sdk references Uno.WinUI.Runtime.Android with IncludeAssets="Build", so its
             transitive AndroidX packages are not compile-visible; reference them directly.
             Added as Uno.Sdk implicit references so their versions come from Uno.Sdk's package
             manifest (the same versions Uno's runtime uses). AppCompat brings in Xamarin.AndroidX.Core. -->
        <_UnoProjectSystemPackageReference Include="Xamarin.AndroidX.AppCompat" ProjectSystem="true" />
        <_UnoProjectSystemPackageReference Include="Xamarin.AndroidX.Browser" ProjectSystem="true" />
      </ItemGroup>
    </When>
    <When Condition="  $(TargetFramework.ToLower().Contains('wasm'))  ">
      <ItemGroup>
        <EmbeddedResource Include="WasmScripts\**\*.*" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
      </ItemGroup>
    </Otherwise>
  </Choose>



</Project>